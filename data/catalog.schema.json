{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Awesome Agent Harness Benchmarks catalog",
  "type": "object",
  "required": ["schema_version", "as_of", "scope", "entries"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "as_of": {"type": "string", "format": "date"},
    "scope": {"type": "string"},
    "entries": {
      "type": "array",
      "minItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "kind", "url", "summary", "signals", "grading", "environment", "limitation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 2},
          "category": {"type": "string"},
          "kind": {"enum": ["benchmark", "study", "watchlist", "infrastructure"]},
          "url": {"type": "string", "format": "uri"},
          "summary": {"type": "string", "minLength": 10},
          "signals": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "grading": {"type": "string", "minLength": 3},
          "environment": {"type": "string", "minLength": 3},
          "limitation": {"type": "string", "minLength": 10},
          "paper": {"type": "string", "format": "uri"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
